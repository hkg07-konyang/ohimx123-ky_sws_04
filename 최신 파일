function loginSubmit(e){e.preventDefault();const email=$('#email').value.trim(),pw=$('#pw').value.trim(),name=$('#name')?.value.trim()||'사용자';let users=load(KEYS.users,[]);if(state.loginMode==='join'){if(!email||!pw)return state.loginError='이메일/비밀번호 입력 필요',render();if(users.some(u=>u.email===email))return state.loginError='이미 있는 이메일',render();const u={id:uid('u'),name,email,pw};users.push(u);save(KEYS.users,users);save(KEYS.session,{id:u.id,name:u.name,email:u.email});state.user={id:u.id,name:u.name,email:u.email};return render()}const u=users.find(x=>x.email===email&&x.pw===pw);if(!u){state.loginError='로그인 실패';return render()}save(KEYS.session,{id:u.id,name:u.name,email:u.email});state.user={id:u.id,name:u.name,email:u.email};render()}
function bindSearch(kind){
  const input=$('#'+kind+'Input'),box=$('#'+kind+'Suggest');
  if(!input||!box)return;
  input.addEventListener('input',()=>{
    if(kind==='origin')state.originText=input.value;else state.destText=input.value;
    if(kind==='origin')state.origin=null;else state.dest=null;
    showSuggestionsDebounced(kind,input.value,box);
  });
  input.addEventListener('focus',()=>showSuggestionsDebounced(kind,input.value,box,80));
  input.addEventListener('keydown',e=>{
    if(e.key==='Enter'){
      e.preventDefault();
      const first=suggestionCache[kind]?.[0];
      if(first){selectSuggestion(kind,first,box,input)}
      else {box.classList.add('hidden');input.blur()}
    }
    if(e.key==='Escape')box.classList.add('hidden');
  });
  setTimeout(()=>document.addEventListener('click',e=>{
    if(!input.contains(e.target)&&!box.contains(e.target))box.classList.add('hidden')
  }),0);
}
function normalizeKeyword(q){return String(q||'').toLowerCase().replace(/\s+/g,'').trim()}
function showSuggestionsDebounced(kind,q,box,delay=260){
  clearTimeout(suggestTimers[kind]);
  suggestTimers[kind]=setTimeout(()=>showSuggestions(kind,q,box),delay);
}
async function showSuggestions(kind,q,box){
  const raw=String(q||'').trim();
  const seq=++suggestSeq[kind];
  if(!raw){
    const items=searchPlaces(raw).slice(0,6);
    suggestionCache[kind]=items;
    renderSuggestionList(kind,items,box);
    return;
  }
  const local=searchPlaces(raw).slice(0,4);
  suggestionCache[kind]=local;
  renderSuggestionList(kind,local,box,raw.length>=2?'카카오맵에서 검색 중...':'두 글자 이상 입력하면 카카오맵 검색 결과가 표시됩니다.');
  if(raw.length<2)return;
  try{
    const kakaoItems=await kakaoSearchPlaces(raw,8);
    if(seq!==suggestSeq[kind])return;
    const merged=mergePlaces(local,kakaoItems).slice(0,9);
    suggestionCache[kind]=merged;
    renderSuggestionList(kind,merged,box);
  }catch(e){
    if(seq!==suggestSeq[kind])return;
    const msg=local.length?'카카오맵 검색을 불러오지 못해 내장 검색 결과만 표시합니다.':'카카오맵 검색 결과가 없습니다.';
    renderSuggestionList(kind,local,box,msg);
  }
}
function renderSuggestionList(kind,items,box,message=''){
  if(!items.length&&!message){box.classList.add('hidden');box.innerHTML='';return}
  const cards=items.map((p,i)=>`<button type="button" class="suggest-card" data-sidx="${i}"><div class="suggest-title">${esc(p.name)}</div><div class="suggest-meta">${esc(p.addr||'주소 정보 없음')}</div><span class="suggest-badge">${esc(p.type||'장소')}</span><span class="suggest-badge">${esc(p.area||'검색')}</span>${p.phone?`<span class="suggest-badge">${esc(p.phone)}</span>`:''}</button>`).join('');
  const note=message?`<div class="${message.includes('검색 중')?'suggest-loading':'suggest-empty'}">${esc(message)}</div>`:'';
  box.innerHTML=cards+note;
  box.classList.remove('hidden');
  box.querySelectorAll('[data-sidx]').forEach(btn=>btn.onclick=(ev)=>{
    ev.preventDefault();
    const p=suggestionCache[kind][+btn.dataset.sidx];
    const input=$('#'+kind+'Input');
    if(p&&input)selectSuggestion(kind,p,box,input);
  });
}
function selectSuggestion(kind,p,box,input){
  const selected={...p,lat:+p.lat,lon:+p.lon};
  if(kind==='origin'){
    state.origin=selected;
    state.originText=selected.name;
    input.value=selected.name;
  }else{
    state.dest=selected;
    state.destText=selected.name;
    input.value=selected.name;
  }
  state.routeError='';
  box.classList.add('hidden');
  if(state.map&&window.kakao?.maps){drawMap();fitBounds(false)}
}
function placeKey(p){return normalizeKeyword((p.name||'')+'|'+(p.addr||''))}
function mergePlaces(a,b){
  const seen=new Set(),out=[];
  [...a,...b].forEach(p=>{
    if(!p||!valid(p))return;
    const key=placeKey(p);
    if(seen.has(key))return;
    seen.add(key);out.push(p);
  });
  return out;
}
function searchPlaces(q){
  const raw=String(q||'').trim();
  const nq=normalizeKeyword(raw);
  let rows=PLACES.map(p=>{
    const fields=[p.name,p.addr,p.area,p.type,...p.aliases];
    const hay=fields.join(' ').toLowerCase();
    const nhay=normalizeKeyword(fields.join(''));
    let score=0;
    if(!nq)score=1;
    else{
      if(normalizeKeyword(p.name).includes(nq))score+=120;
      if(nhay.includes(nq))score+=80;
      if(hay.includes(raw.toLowerCase()))score+=50;
      if(nq.includes('건양')&&(p.name.includes('건양')||p.aliases.join(' ').includes('건양')))score+=80;
      raw.toLowerCase().split(/\s+/).forEach(w=>{if(w&&hay.includes(w))score+=10});
    }
    return {...p,score,source:'local'};
  }).filter(p=>p.score>0).sort((a,b)=>b.score-a.score);
  return rows.slice(0,8)
}
async function geocodeText(text){
  const local=searchPlaces(text)[0];
  if(local)return local;
  if(window.kakao?.maps?.services){try{return await kakaoSearchPlace(text)}catch(e){console.warn('Kakao place search failed:',e)}}
  const url='https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=kr&q='+encodeURIComponent(text);
  const res=await fetch(url,{headers:{'Accept':'application/json'}});
  const data=await res.json();
  if(data&&data[0])return {id:'geo',name:data[0].display_name,addr:data[0].display_name,lat:+data[0].lat,lon:+data[0].lon,type:'검색',area:'외부검색',aliases:[]};
  throw new Error('주소를 찾지 못했습니다: '+text)
}
function kakaoSearchPlaces(text,size=8){
  return new Promise((resolve,reject)=>{
    try{
      if(!window.kakao?.maps?.services)return reject(new Error('카카오 장소검색 서비스가 아직 준비되지 않았습니다.'));
      const ps=new kakao.maps.services.Places();
      ps.keywordSearch(text,(data,status)=>{
        if(status===kakao.maps.services.Status.OK&&data&&data.length){
          resolve(data.map(p=>({
            id:'kakao-'+p.id,
            name:p.place_name||text,
            addr:p.road_address_name||p.address_name||'',
            lat:+p.y,
            lon:+p.x,
            type:p.category_group_name||p.category_name?.split('>').pop()?.trim()||'카카오검색',
            area:'카카오맵',
            phone:p.phone||'',
            placeUrl:p.place_url||'',
            aliases:[],
            source:'kakao'
          })).filter(valid));
        }else if(status===kakao.maps.services.Status.ZERO_RESULT){
          resolve([]);
        }else reject(new Error('카카오맵 장소검색 실패: '+status));
      },{size});
    }catch(e){reject(e)}
  })
}
function kakaoSearchPlace(text){return kakaoSearchPlaces(text,1).then(items=>{if(items[0])return items[0];throw new Error('카카오맵에서 장소를 찾지 못했습니다: '+text)})}
async function resolvePoints(){let start=state.origin;if(!state.originText.trim()){if(state.location)start={...state.location,name:'현재 위치',addr:'GPS'};else start=PLACES.find(p=>p.id==='daejeon-city')}else if(!start||start.name!==state.originText.trim())start=await geocodeText(state.originText.trim());let end=state.dest;if(!state.destText.trim())throw new Error('목적지를 입력하세요.');if(!end||end.name!==state.destText.trim())end=await geocodeText(state.destText.trim());if(!valid(start)||!valid(end))throw new Error('좌표가 올바르지 않습니다.');state.origin=start;state.dest=end;return {start,end}}
async function calcRoute(){state.loading=true;state.routeError='';state.routes=[];state.selected=null;render();try{const {start,end}=await resolvePoints();let routes=[];if(state.mode==='car')routes=await osrmRoute(start,end);else routes=await pedestrianRoutes(start,end,state.mode);if(!routes.length)throw new Error('경로 서버가 결과를 반환하지 않았습니다. 직선 경로는 만들지 않습니다.');state.routes=routes;state.selected=routes[0].id;state.loading=false;render()}catch(e){state.loading=false;state.routeError=humanRouteError(e);render()}}
async function fetchJSON(url,opt={},timeout=9000){const ctrl=new AbortController();const timer=setTimeout(()=>ctrl.abort(),timeout);try{const res=await fetch(url,{...opt,signal:ctrl.signal,cache:'no-store',headers:{'Accept':'application/json',...(opt.headers||{})}});if(!res.ok)throw new Error('HTTP '+res.status);return await res.json()}catch(e){if(e.name==='AbortError')throw new Error('TIMEOUT');throw e}finally{clearTimeout(timer)}}
function humanRouteError(e){const msg=(e&&e.message)||String(e||'');if(/Load failed|Failed to fetch|NetworkError|TIMEOUT|abort/i.test(msg))return '외부 경로 서버 연결이 막혔습니다. 인터넷 연결, Netlify 새 배포, 또는 잠시 후 재시도를 확인하세요. 앱은 직선 경로를 만들지 않습니다.';return msg}
async function pedestrianRoutes(start,end,mode){const errors=[];for(const fn of [valhallaRoute,osrmFootRoute,localWalkingRoute]){try{const routes=await fn(start,end,mode);if(routes&&routes.length){if(mode==='safe'){routes[0].title='밝은길 우선 경로';routes[0].reliability=Math.min(96,routes[0].reliability+safeBonus(routes[0]));}return routes}}catch(e){errors.push(e.message||String(e))}}throw new Error('보행자 경로를 찾지 못했습니다. 시도: Valhalla → OSM Foot Router → 내장 보행망. 원인: '+errors.join(' / '))}
async function valhallaRoute(start,end,mode){const req={locations:[{lat:start.lat,lon:start.lon,type:'break'},{lat:end.lat,lon:end.lon,type:'break'}],costing:'pedestrian',costing_options:{pedestrian:{walking_speed:5,use_ferry:0,use_living_streets:0.8,use_tracks:0.15,service_penalty:40,service_factor:1.4}},directions_options:{units:'kilometers',language:'ko-KR'}};const endpoints=['https://valhalla1.openstreetmap.de/route?json=','https://valhalla.openstreetmap.de/route?json='];let last='';for(const ep of endpoints){try{const json=await fetchJSON(ep+encodeURIComponent(JSON.stringify(req)),{},8500);const leg=json.trip?.legs?.[0];if(!leg?.shape)throw new Error('shape 없음');const geom=decodePolyline(leg.shape,6).filter(valid);if(geom.length<2)throw new Error('좌표 부족');let maneuvers=(leg.maneuvers||[]).map(m=>({text:koInstruction(m.instruction||m.verbal_pre_transition_instruction||'경로를 따라 이동하세요'),distance:(m.length||0)*1000,duration:m.time||60,begin:m.begin_shape_index||0}));let dist=(json.trip.summary?.length||sumDist(geom)/1000)*1000,dur=json.trip.summary?.time||dist/1.25;return [makeRoute('보행자 추천 경로',geom,dist,dur,mode,'Valhalla pedestrian / OSM',maneuvers)]}catch(e){last=e.message||String(e)}}throw new Error('Valhalla 실패: '+last)}
async function osrmFootRoute(start,end,mode){const url=`https://routing.openstreetmap.de/routed-foot/route/v1/foot/${start.lon},${start.lat};${end.lon},${end.lat}?overview=full&geometries=geojson&steps=true&alternatives=true`;const json=await fetchJSON(url,{},9000);if(json.code!=='Ok')throw new Error('OSM Foot Router 코드: '+(json.code||'unknown'));return json.routes.slice(0,2).map((r,i)=>makeRoute(i?'보행자 대안 경로':'보행자 추천 경로',r.geometry.coordinates.map(c=>({lat:c[1],lon:c[0]})).filter(valid),r.distance,r.duration,mode,'OSM Foot Router',r.legs?.[0]?.steps?.map(s=>({text:osrmStep(s),distance:s.distance,duration:s.duration,begin:0}))||[]))}
function localWalkingRoute(start,end,mode){const nearCampus=meters(start,{lat:36.3057,lon:127.3438})<1800&&meters(end,{lat:36.3057,lon:127.3438})<1800;if(!nearCampus)throw new Error('내장 보행망은 건양대 메디컬캠퍼스 주변에서만 사용 가능');const gate={lat:36.30573,lon:127.34525};const hospitalRoad={lat:36.30605,lon:127.34310};const campusMid={lat:36.30545,lon:127.34370};const westWalk={lat:36.30505,lon:127.34250};let geom=[{lat:start.lat,lon:start.lon}];const add=p=>{if(meters(geom[geom.length-1],p)>8)geom.push(p)};add(westWalk);add(campusMid);add(hospitalRoad);add(gate);add({lat:end.lat,lon:end.lon});geom=dedupeGeom(geom).filter(valid);let dist=sumDist(geom),dur=dist/1.25;return [makeRoute('학교 주변 내장 보행망',geom,dist,dur,mode,'내장 보행망 · 외부 API 실패 시',stepsFromGeom(geom,dist,dur))]}
function dedupeGeom(g){return g.filter((p,i)=>i===0||meters(p,g[i-1])>5)}
function stepsFromGeom(geom,d,t){const n=Math.max(1,geom.length-1);return geom.slice(1).map((p,i)=>({text:i===0?'출발 후 보행로를 따라 이동하세요':i===n-1?'목적지 방향으로 마지막 구간을 이동하세요':'건물 사이를 관통하지 말고 보행로/차도 가장자리 인도를 따라 이동하세요',distance:d/n,duration:t/n,begin:i}))}
async function osrmRoute(start,end){const url=`https://router.project-osrm.org/route/v1/driving/${start.lon},${start.lat};${end.lon},${end.lat}?overview=full&geometries=geojson&steps=true&alternatives=true`;const json=await fetchJSON(url,{},9000);if(json.code!=='Ok')throw new Error('자동차 경로 API 오류');return json.routes.slice(0,2).map((r,i)=>makeRoute('자동차 경로 '+(i+1),r.geometry.coordinates.map(c=>({lat:c[1],lon:c[0]})).filter(valid),r.distance,r.duration,'car','OSRM driving',r.legs?.[0]?.steps?.map(s=>({text:osrmStep(s),distance:s.distance,duration:s.duration,begin:0}))||[]))}
function makeRoute(title,geom,distance,duration,mode,source,steps){const facilities=FAC.filter(f=>minDistToGeom(f,geom)<850);const e={cctv:facilities.filter(f=>f.type==='cctv').length,light:facilities.filter(f=>f.type==='light').length,store:facilities.filter(f=>f.type==='store').length,police:facilities.filter(f=>f.type==='police').length,risk:facilities.filter(f=>f.type==='risk').length};let reliability=source.includes('Valhalla')?88:source.includes('OSM Foot')?84:source.includes('내장')?62:78;reliability+=Math.min(9,e.light*2+e.store*2+e.police*3+e.cctv);reliability-=e.risk*7;if(state.accuracy&&state.accuracy>80)reliability-=8;steps=normalizeSteps(steps,distance,duration);return {id:uid('r'),title,geom,distance,duration,distanceText:fmtM(distance),durationText:fmtT(duration),mode,source,facilities,e,reliability:Math.max(35,Math.min(96,Math.round(reliability))),steps}}
function normalizeSteps(steps,d,t){if(!steps||!steps.length)return [{text:'출발지에서 보행 가능한 큰길로 이동하세요',distance:d*.25,duration:t*.25},{text:'경로선을 따라 계속 이동하세요',distance:d*.5,duration:t*.5},{text:'목적지 주변에서 도착 확인을 하세요',distance:d*.25,duration:t*.25}];return steps.filter(s=>s.distance>1||s.text).slice(0,14).map(s=>({...s,text:koInstruction(s.text),distance:s.distance||d/(steps.length||1),duration:s.duration||t/(steps.length||1)}))}
function koInstruction(t){t=String(t||'경로를 따라 이동하세요');return t.replace(/Continue/gi,'직진').replace(/Turn left/gi,'좌회전').replace(/Turn right/gi,'우회전').replace(/Destination/gi,'목적지').replace(/Walk/gi,'이동')}
function osrmStep(s){const type=s.maneuver?.type,mod=s.maneuver?.modifier,name=s.name;if(type==='depart')return '출발지에서 경로를 시작하세요';if(type==='arrive')return '목적지에 도착합니다';if(type==='turn')return (mod?.includes('left')?'좌회전':mod?.includes('right')?'우회전':'방향 전환')+(name?` 후 ${name} 방면`:'');return name?`${name} 따라 이동`:'경로를 따라 이동하세요'}
function decodePolyline(str,precision=6){let index=0,lat=0,lng=0,coords=[],factor=Math.pow(10,precision);while(index<str.length){let b,shift=0,result=0;do{b=str.charCodeAt(index++)-63;result|=(b&0x1f)<<shift;shift+=5}while(b>=0x20);lat+=((result&1)?~(result>>1):(result>>1));shift=0;result=0;do{b=str.charCodeAt(index++)-63;result|=(b&0x1f)<<shift;shift+=5}while(b>=0x20);lng+=((result&1)?~(result>>1):(result>>1));coords.push({lat:lat/factor,lon:lng/factor})}return coords}
function sumDist(g){let d=0;for(let i=1;i<g.length;i++)d+=meters(g[i-1],g[i]);return d}
function safeBonus(r){return Math.min(8,r.e.light*2+r.e.store*1+r.e.police*2-r.e.risk*2)}
function curRoute(){return state.routes.find(r=>r.id===state.selected)}
function minDistToGeom(p,g){let min=Infinity;for(let i=1;i<g.length;i++)min=Math.min(min,pointSegDist(p,g[i-1],g[i]));return min}
function pointSegDist(p,a,b){const x=p.lon,y=p.lat,x1=a.lon,y1=a.lat,x2=b.lon,y2=b.lat,dx=x2-x1,dy=y2-y1;let t=((x-x1)*dx+(y-y1)*dy)/(dx*dx+dy*dy||1);t=Math.max(0,Math.min(1,t));return meters(p,{lat:y1+t*dy,lon:x1+t*dx})}
async function initMap(){const el=$('#map');if(!el)return;try{await ensureKakaoMapReady();const fallback=$('#fallback');if(fallback)fallback.classList.add('hidden');el.classList.remove('hidden');clearKakaoLayers();state.map=new kakao.maps.Map(el,{center:new kakao.maps.LatLng(36.3504,127.3849),level:5});state.map.addControl(new kakao.maps.ZoomControl(),kakao.maps.ControlPosition.RIGHT);drawMap();fixMap()}catch(e){showFallback(e.message+' / 도메인은 https://elegant-raindrop-bafbab.netlify.app 형식으로 등록하고, Netlify에 새 파일을 다시 배포한 뒤 강력 새로고침하세요.')}}
function addTileLayer(){/* Kakao Maps는 별도 타일 레이어 추가가 필요 없습니다. */}
function kakaoLatLng(p){return new kakao.maps.LatLng(+p.lat,+p.lon)}
function clearKakaoLayers(){state.layers.forEach(l=>{try{l.setMap(null)}catch{}});state.layers=[];if(state.meMarker){try{state.meMarker.setMap(null)}catch{}state.meMarker=null}}
function addKakaoMarker(p,title){const marker=new kakao.maps.Marker({position:kakaoLatLng(p),map:state.map,title:title||''});state.layers.push(marker);if(title){const infowindow=new kakao.maps.InfoWindow({content:`<div style="padding:7px 10px;font-size:13px;white-space:nowrap">${esc(title)}</div>`});kakao.maps.event.addListener(marker,'click',()=>infowindow.open(state.map,marker));state.layers.push({setMap:m=>infowindow.close()});}return marker}
function addKakaoEmoji(p,emoji,title){const overlay=new kakao.maps.CustomOverlay({position:kakaoLatLng(p),yAnchor:.5,xAnchor:.5,content:`<div class="facility-dot" title="${esc(title||'')}">${emoji||'•'}</div>`});overlay.setMap(state.map);state.layers.push(overlay);return overlay}
function drawMap(){if(!state.map||!window.kakao?.maps)return;clearKakaoLayers();const r=curRoute();state.routes.forEach(rt=>{const line=new kakao.maps.Polyline({map:state.map,path:rt.geom.map(kakaoLatLng),strokeWeight:rt.id===state.selected?8:4,strokeColor:rt.id===state.selected?'#2563eb':'#9ca3af',strokeOpacity:rt.id===state.selected?.95:.55,strokeStyle:'solid'});state.layers.push(line)});if(r)r.facilities.forEach(f=>addKakaoEmoji(f,FICON[f.type]||'•',`${f.name} · 시연 데이터`));if(state.origin)addKakaoMarker(state.origin,'출발지');if(state.dest)addKakaoMarker(state.dest,'목적지');updateMeMarker();fitBounds()}
function fixMap(){try{if(state.map){state.map.relayout();fitBounds(false)}}catch{}}
function fitBounds(animated=true){if(!state.map||!window.kakao?.maps)return;const pts=[];state.routes.forEach(r=>r.geom.forEach(p=>pts.push(p)));if(state.origin)pts.push(state.origin);if(state.dest)pts.push(state.dest);if(state.location)pts.push(state.location);try{if(pts.length>=2){const bounds=new kakao.maps.LatLngBounds();pts.forEach(p=>bounds.extend(kakaoLatLng(p)));state.map.setBounds(bounds,45,45,45,45)}else state.map.setCenter(new kakao.maps.LatLng(36.3504,127.3849));}catch{}}
function showFallback(msg){const f=$('#fallback'),m=$('#map');if(m)m.classList.add('hidden');if(f){f.classList.remove('hidden');f.innerHTML=`<div><h3>지도 표시 오류</h3><p>${esc(msg)}</p><p class="muted">카카오 JavaScript 키와 카카오 Developers의 Web 플랫폼 도메인 등록을 확인하세요.</p></div>`}}
async function getLocation(){if(!state.consent.location){state.consent.location=true;save(KEYS.consent,state.consent)}return new Promise((resolve,reject)=>{if(!navigator.geolocation){alert('위치 기능 없음');return reject()}navigator.geolocation.getCurrentPosition(pos=>{state.location={lat:pos.coords.latitude,lon:pos.coords.longitude};state.accuracy=pos.coords.accuracy;updateMeMarker();sendLocationServer();resolve(state.location)},err=>{alert('GPS 오류: '+err.message);reject(err)},{enableHighAccuracy:true,timeout:12000,maximumAge:2500})})}
function startWatch(){if(!state.consent.location){state.consent.location=true;save(KEYS.consent,state.consent)}if(!navigator.geolocation)return alert('위치 지원 안 됨');if(state.watchId)navigator.geolocation.clearWatch(state.watchId);state.watchId=navigator.geolocation.watchPosition(pos=>{const prev=state.location;state.location={lat:pos.coords.latitude,lon:pos.coords.longitude,t:Date.now(),prev};state.accuracy=pos.coords.accuracy;state.nav=true;updateNavIndex();updateMeMarker();sendLocationServer();if(state.tab!=='route')render()},err=>alert('GPS 오류: '+err.message),{enableHighAccuracy:true,timeout:12000,maximumAge:1500});state.nav=true;state.navStartAt=Date.now();render()}
function stopWatch(){if(state.watchId)navigator.geolocation.clearWatch(state.watchId);state.watchId=null;state.nav=false;render()}
function toggleNavigation(){if(state.nav)return stopWatch();return startNavigation()}
function startNavigation(){if(!curRoute())return alert('먼저 경로를 계산하세요.');state.nav=true;state.navStartAt=Date.now();startWatch()}
function updateMeMarker(){if(!state.map||!state.location||!window.kakao?.maps)return;const position=kakaoLatLng(state.location);if(!state.meMarker){state.meMarker=new kakao.maps.CustomOverlay({position,yAnchor:.5,xAnchor:.5,content:'<div class="me-dot" title="현재 위치"></div>'});state.meMarker.setMap(state.map)}else state.meMarker.setPosition(position);try{if(state.nav)state.map.panTo(position)}catch{}}
function updateNavIndex(){const r=curRoute();if(!r||!state.location)return;let best={d:Infinity,i:0};r.geom.forEach((p,i)=>{const d=meters(state.location,p);if(d<best.d)best={d,i}});let cum=0,target=0;for(let s=0;s<r.steps.length;s++){cum+=r.steps[s].distance;if(best.i/r.geom.length*r.distance<=cum){target=s;break}}state.navIndex=target}
function remainingDistance(){const r=curRoute();if(!r||!state.location)return 0;let near=0,best=Infinity;r.geom.forEach((p,i)=>{const d=meters(state.location,p);if(d<best){best=d;near=i}});let rem=0;for(let i=near+1;i<r.geom.length;i++)rem+=meters(r.geom[i-1],r.geom[i]);return rem}
function calcSpeed(){const p=state.location?.prev;if(!p||!state.location?.t||!p.t)return 0;return meters(p,state.location)/((state.location.t-p.t)/1000)*3.6||0}
function turnIcon(t=''){if(t.includes('좌'))return '↰';if(t.includes('우'))return '↱';if(t.includes('도착'))return '●';return '↑'}
function connectServer(){const url=$('#serverUrl').value.trim().replace(/\/$/,'');state.server.url=url;save(KEYS.server,state.server);if(!url)return alert('서버 URL을 입력하세요.');try{state.socket=io(url,{transports:['websocket','polling'],timeout:8000});state.socket.on('connect',()=>{state.server.connected=true;state.server.socketId=state.socket.id;save(KEYS.server,state.server);render()});state.socket.on('connect_error',()=>{state.server.connected=false;save(KEYS.server,state.server);alert('서버 연결 실패. server 폴더를 먼저 배포해야 합니다.');render()});state.socket.on('room-created',d=>{state.server.room=d.room;state.shareToken=d.token;save(KEYS.server,state.server);render()})}catch(e){alert('연결 오류: '+e.message)}}
function createRoom(){if(!state.socket||!state.server.connected)return alert('서버 먼저 연결');state.socket.emit('create-room',{userId:state.user.id,name:state.user.name})}
function shareUrl(){const base=location.origin+location.pathname;return `${base}?guardian=${encodeURIComponent(state.shareToken||state.server.room||'demo')}&server=${encodeURIComponent(state.server.url||'')}`}
function copyShare(){copyText(shareUrl(),'보호자 링크 복사 완료')}
function sendLocationServer(){if(!state.socket||!state.server.connected||!state.server.room||!state.location)return;state.socket.emit('location:update',{room:state.server.room,user:{id:state.user.id,name:state.user.name},location:state.location,accuracy:state.accuracy,time:Date.now(),route:curRoute()?.title||''})}
function sosMessage(){const loc=state.location?`${state.location.lat.toFixed(5)}, ${state.location.lon.toFixed(5)}`:'위치 미확인';return `[S.R.H 긴급] 도움이 필요합니다. 위치: ${loc}. 시간: ${now()}. 실제 상황이면 112 신고가 우선입니다.`}
function sendSosServer(){const msg=sosMessage();state.incidents.unshift({id:uid('sos'),type:'SOS',time:now(),msg});save(KEYS.incidents,state.incidents);if(state.socket&&state.server.connected)state.socket.emit('sos',{room:state.server.room,msg,location:state.location,time:Date.now()});alert('SOS 처리 완료. 실제 위급 상황이면 112에 전화하세요.');render()}
function setupHold(){const b=$('#sosHold');let start=()=>{if(state.holdTimer)return;state.hold=0;state.holdTimer=setInterval(()=>{state.hold+=4;b.style.setProperty('--p',state.hold+'%');b.querySelector('small').textContent=Math.round(state.hold)+'%';if(state.hold>=100){clearInterval(state.holdTimer);state.holdTimer=null;sendSosServer()}},120)},end=()=>{if(state.holdTimer){clearInterval(state.holdTimer);state.holdTimer=null;state.hold=0;render()}};b.onmousedown=start;b.ontouchstart=e=>{e.preventDefault();start()};b.onmouseup=end;b.onmouseleave=end;b.ontouchend=end}
function copyText(t,msg){navigator.clipboard?.writeText(t).then(()=>alert(msg)).catch(()=>alert(t))}
window.addEventListener('load',init);

  </script>
